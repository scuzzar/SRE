    "events": [
      {"id": "chameleon", "name": "Chameleon", "group": "Animals", "text": "Sehr gut getarnte Tiere. Greift das Tier an, beginnt die Begegnung auf Close und es hat Überraschung; sonst gibt es keine.", "lifeless": false},
      {"id": "psionic-assaulters", "name": "Psionic Assaulters", "group": "Animals", "text": "Telepathische Fleischfresser greifen psionisch an und bleiben bis 50 m entfernt verborgen, bis die Gruppe großteils außer Gefecht ist.", "lifeless": false},
      {"id": "circling-flyers", "name": "Circling Flyers", "group": "Animals", "text": "Flieger kreisen über der Gruppe; nach etwa 10 Minuten greifen Chaser an.", "lifeless": false},
      {"id": "poisonous-pests", "name": "Poisonous Pests", "group": "Animals", "text": "Winzige giftige Tiere sind in die Ausrüstung gekrochen und greifen an, wenn man hineinfasst: 3W6 Schaden, außer man würfelt DEX oder weniger.", "lifeless": false, "save": "DEX", "damage": 3},
      {"id": "stampede", "name": "Stampede", "group": "Animals", "text": "Eine Herde Grazer, von Fleischfressern aufgescheucht, rennt in die Gruppe. Lärm oder Laser lenken sie ab. Jeder 8+, sonst 2W6 Schaden.", "lifeless": false, "save": "8+", "damage": 2},
      {"id": "rutting-season", "name": "Rutting Season", "group": "Animals", "text": "Ein großer Pflanzenfresser hält das ATV für einen Rivalen und greift es an: je Runde 10+ (DM + Fahrerfertigkeit), sonst Kollision; repariert bei 9+ je Kollision.", "lifeless": false},
      {"id": "lair", "name": "Lair", "group": "Animals", "text": "Ein Bau mit fünf jungen Pouncern; bleibt die Gruppe länger als ein paar Minuten, kommt die Mutter und greift sofort an.", "lifeless": false},
      {"id": "hallucinogenic-pollen", "name": "Hallucinogenic Pollen", "group": "Plants", "text": "Ein Blumenfeld; die Pollen lösen bedrohliche Halluzinationen aus, bis etwa 20 Minuten nach Verlassen.", "lifeless": false},
      {"id": "carnivorous-plants", "name": "Carnivorous Plants", "group": "Plants", "text": "Der Boden bricht unter dem Vordersten ein: 4 m tiefe Grube mit Stacheln und Verdauungsflüssigkeit; wer nicht in wenigen Minuten gerettet wird, wird verdaut.", "lifeless": false},
      {"id": "dense-fog", "name": "Dense Fog", "group": "Weather", "text": "Sicht nur auf Medium, sicheres Reisen mit halber Geschwindigkeit.", "lifeless": false},
      {"id": "sandstorm", "name": "Sandstorm", "group": "Weather", "text": "12 Stunden kein Vorankommen; Einzelne werden verschüttet, Scheiben blind.", "lifeless": false},
      {"id": "rainstorm", "name": "Rainstorm", "group": "Weather", "text": "Schlechte Sicht, tiefer Schlamm; Reisen für den Tag mit Viertelgeschwindigkeit.", "lifeless": false},
      {"id": "prairie-fire", "name": "Prairie Fire", "group": "Natural Disasters", "text": "Feuerfront, 20 km breit; Umweg 4 Stunden, dabei 3 Begegnungen würfeln.", "lifeless": false},
      {"id": "flash-flood", "name": "Flash Flood", "group": "Natural Disasters", "text": "Eine Wasserwand im Flussbett. Fahrzeuge 10+, sonst zerstört; Einzelne 9+, sonst mitgerissen und 3W6 Schaden.", "lifeless": false, "save": "9+", "damage": 3},
      {"id": "seismic-quake", "name": "Seismic Quake", "group": "Natural Disasters", "text": "Der Boden bebt. Jeder würfelt STR oder weniger, sonst 1W6 Schaden.", "lifeless": false, "save": "STR", "damage": 1},
      {"id": "broken-ground", "name": "Broken Ground", "group": "Terrain Features", "text": "Sehr rauer Boden; ein ATV fährt Viertelgeschwindigkeit oder riskiert je Stunde einen Kettenbruch (6+ vermeidet ihn).", "lifeless": false},
      {"id": "oasis", "name": "Oasis", "group": "Terrain Features", "text": "Ein Teich in dichtem Bewuchs; bei 8+ ist das Wasser trinkbar.", "lifeless": false},
      {"id": "crevasse", "name": "Crevasse", "group": "Terrain Features", "text": "Eine tiefe Spalte versperrt den Weg; Umweg 2W6 Stunden.", "lifeless": false},
      {"id": "ford", "name": "Ford", "group": "Terrain Features", "text": "Sandbänke machen den Fluss für Fahrzeuge passierbar.", "lifeless": false},
      {"id": "statues", "name": "Statues", "group": "Curiosities", "text": "Eine halb vergrabene Steinstatue: Menschenleib, Kopf eines örtlichen Fleischfressers.", "lifeless": false},
      {"id": "jungle-drums", "name": "Jungle Drums", "group": "Curiosities", "text": "Nachts ferne Trommeln mit Antwort aus anderer Richtung: Paarungsrufe eines großen Omnivoren.", "lifeless": false},
      {"id": "marsh-gas", "name": "Marsh Gas", "group": "Curiosities", "text": "Wandernde Lichter in der Ferne, leicht mit einem Air/Raft zu verwechseln.", "lifeless": false},
      {"id": "dust-pool", "name": "Dust Pool", "group": "Vacuum Worlds", "text": "Ein Krater voll feinem Staub: Wer hindurchgeht, bei 10+ fällt sein Vacc Suit aus; im Fahrzeug jede Stunde 10+ für einen Ausfall der Elektronik.", "lifeless": true},
      {"id": "solar-storm", "name": "Solar Storm", "group": "Vacuum Worlds", "text": "Funk ist für mehrere Tage unmöglich.", "lifeless": true},
      {"id": "magnetic-anomaly", "name": "Magnetic Anomaly", "group": "Vacuum Worlds", "text": "Der Kompass weicht bis zu 60 Grad ab; wer es nicht merkt, kommt vom Kurs ab.", "lifeless": true},
      {"id": "tracks", "name": "Tracks", "group": "Vacuum Worlds", "text": "ATV-Spuren; in der richtigen Richtung führen sie zur Zivilisation.", "lifeless": true},
      {"id": "pressure-tent", "name": "Pressure Tent", "group": "Vacuum Worlds", "text": "Ein kleines aufblasbares Zelt mit Atemluft, ohne Strom; der Besitzer liegt einige hundert Meter weiter unter einem Steinschlag.", "lifeless": true}
    ]
  }
