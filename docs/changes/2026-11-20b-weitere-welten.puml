  }
  class Star $raum
  class Satellite $raum {
    kind: SatelliteKind
    size: number [0..1]
    diameter: number [0..1]
    orbit: number
    angle: number
    atmosphere: number [0..1]
    hydrographics: number [0..1]
    population: number [0..1]
    /gravity: number
  }
  enum SatelliteKind <<value>> $raum
  class GasGiant $raum {
    $gone("2026-11-20b", "large: boolean")
    $gone("2026-11-20b", "radius: number")
    $gone("2026-11-20b", "orbit: number")
    $gone("2026-11-20b", "/zone: Zone")
    $gone("2026-11-20b", "/gravity: number")
  }
  class Planet $raum $newClass("2026-11-20b") {
    kind: PlanetKind
    orbit: number
    captured: boolean
    size: number [0..1]
    diameter: number [0..1]
    large: boolean [0..1]
    radius: number [0..1]
    atmosphere: number [0..1]
    hydrographics: number [0..1]
    population: number [0..1]
    /zone: Zone
    /gravity: number
  }
  enum PlanetKind <<value>> $raum $newClass("2026-11-20b") {
    world
    small
    belt
    giant
  }
  class SpaceUnit $raum

