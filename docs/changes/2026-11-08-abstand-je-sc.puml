' Subsektor und Welten

' Verlauf

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Encounter $begegnung {
    at: datetime
    quantityDie: number [0..1]
    reactionDice: number[2]
    reactionDm: number [0..1]
    reaction: number
    ended: boolean
    /reactionText: string
    rangeDice: number[2]
    bandDie: number [0..1]
    $gone("2026-11-08d", "band: number")
    $new("2026-11-08d", "startBand: number")
    $gone("2026-11-08d", "close: boolean")
    $new("2026-11-08d", "startClose: boolean")
    $gone("2026-11-08d", "/range: Range [0..1]")
    $gone("2026-11-08d", "/escaped: boolean")
    round: number
    $gone("2026-11-08d", "pcMoved: number [0..1]")
    npcMoved: number [0..1]
    $gone("2026-11-08d", "pcRuns: number [0..1]")
    npcRuns: number [0..1]
    alarm: number [0..1]
    /surprise: Side [0..1]
    /surprising: Side [0..1]
    /first: Side
  }
  class Distance $begegnung $newClass("2026-11-08d") {
    band: number
    close: boolean
    moved: number [0..1]
    runs: number [0..1]
    /range: Range [0..1]
    /escaped: boolean
  }
  class SurpriseRoll <<value>> $begegnung
  enum Side <<value>> $begegnung
  class Terrain <<reference>> $begegnung
  class EncounterType <<reference>> $begegnung

