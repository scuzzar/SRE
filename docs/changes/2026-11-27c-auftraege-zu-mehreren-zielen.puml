' Kampagne und Charaktere
  class Booking $shop {
    at: datetime
    kind: BookingKind
    amount: number
    count: number [0..1]
    text: string [0..1]
    shipCost: ShipCost [0..1]
    shipIncome: ShipIncome [0..1]
  }
  enum BookingKind <<value>> $shop

' Schiffe
  class Ship $schiffe {
    name: string
    fuel: number
    unrefined: number
    /cargo: number
    price: number
    initialLoan: number [0..1]
    loanBalance: number [0..1]
    /monthlyPayment: number [0..1]
    nextPaymentDay: number [0..1]
    berthedSince: number [0..1]
    retired: boolean
    aboard: boolean
    inOrbit: boolean
    inHold: boolean
    mailContract: boolean
  }
  class ShipSoftware $schiffe
  class CrewPost $schiffe
  class Turret $schiffe
  class ShipDesign <<reference>> $schiffe

' Handel (Regeln: docs/regeln-handel.md)
  class Market $handel {
    week: number
    /current: boolean
  }
  class GoodsRoll $handel
  class PriceRoll $handel
  class Cargo $handel
  class Fare $handel $newClass("2026-11-27c") {
    high: number
    middle: number
    low: number
    retired: boolean
  }
  class MessageOffer <<value>> $handel {
    dice: number[2]
    /available: boolean
    die: number
    /fee: number
    taken: boolean
  }
  class FreightOffer <<value>> $handel
  class PassengerOffer <<value>> $handel

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)

' Charaktererschaffung und Lebenslauf

' Subsektor und Welten
  class Hex $sektor {
    column: number
    row: number
    empty: boolean
    navalBase: boolean [0..1]
    scoutBase: boolean [0..1]
    gasGiant: boolean [0..1]
    travelZone: TravelZone [0..1]
    /step: WorldStep
  }
  class World $sektor {
    kind: WorldKind
    name: string [0..1]
    note: string [0..1]
    populationMultiplier: number [0..1]
    orbit: number [0..1]
    angle: number [0..1]
    captured: boolean
    diameter: number [0..1]
    large: boolean [0..1]
    radius: number [0..1]
    spaceport: Spaceport [0..1]
    facilities: Facility [*]
    bases: BaseKind [*]
    /main: boolean
    /zone: Zone [0..1]
    /gravity: number
  }
  enum WorldKind <<value>> $sektor
  enum Spaceport <<value>> $sektor
  enum BaseKind <<value>> $sektor
  enum Facility <<value>> $sektor
  class Uwp <<value>> $sektor
  class WorldRoll <<transient>> $sektor

' Missionen

' Verlauf

' Zeit und Reisen
  class Journey $reise {
    days: number
    high: number
    middle: number
    $new("2026-11-27c", "low: number")
    mail: boolean
    npcDie: number [0..1]
    lot: number [0..1]
    /pot: number
    jump: number[2]
    jumpDm: number
    /misjump: boolean
    departureRoll: number[2] [0..1]
    arrivalRoll: number[2] [0..1]
  }
  class Passenger <<value>> $reise
  class Voyage $reise
  class LowBerth <<value>> $reise

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)

