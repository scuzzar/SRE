' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!$change = "2026-11-18b"
' Markierung offener Änderungen (siehe Skill domain-model, „Ausschnitte und Markierungen“).
' Ein Kennzeichen wie "2026-11-06" steht an allem, was eine noch nicht freigegebene Änderung
' bringt oder streicht; nach der Freigabe kommen die Kennzeichen wieder heraus. Rot ist also immer,
' was noch nicht freigegeben ist. Ein Änderungsausschnitt setzt $change auf sein Kennzeichen und
' zeigt nur diese Änderung rot; sonst ist alles Offene rot.
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Änderung 2026-11-18b: Sternsystem nach Book 6: Sterne, Bahnen und Zonen, Gasriesen und Hauptwelt platziert, Monde und Ringe; Systemflug auch am Gasriesen
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere

' Schiffe

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)
  class SystemFlight $raum $newClass("2026-11-18") {
    startedAt: datetime
    round: number
    /elapsed: number
  }
  class StarSystem $raum $newClass("2026-11-18b") {
    maxOrbits: number
    worldOrbit: number
    hostOrbit: number [0..1]
    hostAngle: number [0..1]
    /worldZone: Zone
  }
  class Star $raum $newClass("2026-11-18b") {
    type: StarType
    decimal: number [0..1]
    size: StarSize
    orbit: number [0..1]
    close: boolean
    farAu: number [0..1]
  }
  enum StarType <<value>> $raum $newClass("2026-11-18b") {
    O
    B
    A
    F
    G
    K
    M
  }
  enum StarSize <<value>> $raum $newClass("2026-11-18b") {
    Ia
    Ib
    II
    III
    IV
    V
    VI
    D
  }
  enum Zone <<value>> $raum $newClass("2026-11-18b") {
    inner
    habitable
    outer
  }
  class StarZones <<reference>> $raum $newClass("2026-11-18b") {
    type: StarType
    decimal: number [0..1]
    size: StarSize
    firstOrbit: number
    habitableOrbit: number [0..1]
  }
  class Satellite $raum $newClass("2026-11-18b") {
    kind: SatelliteKind
    size: number [0..1]
    diameter: number [0..1]
    orbit: number
    angle: number
    atmosphere: number [0..1]
    hydrographics: number [0..1]
    population: number [0..1]
    /gravity: number
  }
  enum SatelliteKind <<value>> $raum $newClass("2026-11-18b") {
    moon
    small
    ring
  }
  class GasGiant $raum $newClass("2026-11-18b") {
    large: boolean
    radius: number
    orbit: number
    /zone: Zone
    /gravity: number
  }
  class SpaceUnit $raum $newClass("2026-11-18")

' Charaktererschaffung und Lebenslauf

' Subsektor und Welten
  class Hex $sektor {
    column: number
    row: number
    empty: boolean
    name: string [0..1]
    navalBase: boolean [0..1]
    scoutBase: boolean [0..1]
    gasGiant: boolean [0..1]
    note: string [0..1]
    populationMultiplier: number [0..1]
    /step: WorldStep
  }
  class Uwp <<value>> $sektor
  class WorldRoll <<transient>> $sektor

' Verlauf

' Zeit und Reisen

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)

' Referenzdaten
  class Surface <<value>> $sektor
' Fahrzeuge und Wege auf der Oberfläche
  class Temperature <<reference>> $sektor
  class TradeCode <<reference>> $sektor
  enum WorldStep <<value>> $sektor

' Kampagne

' Schiffe

' Raumkarte und Systemflug
SystemFlight "*" -$newArrow("2026-11-18")-> "1" Hex : world
SystemFlight "1" *-$newArrow("2026-11-18")- "1..*" SpaceUnit : units {ordered}
Hex "1" *-$newArrow("2026-11-18b")- "0..1" StarSystem : system
StarSystem "1" *-$newArrow("2026-11-18b")- "1..3" Star : stars {ordered}
StarSystem "1" *-$newArrow("2026-11-18b")- "*" Satellite : satellites {ordered}
StarSystem "1" *-$newArrow("2026-11-18b")- "*" GasGiant : giants {ordered}
StarSystem "*" -$newArrow("2026-11-18b")-> "0..1" GasGiant : host
Star "*" -$newArrow("2026-11-18b")-> "1" StarZones : /zones
Star --> StarType
Star --> StarSize
SystemFlight "*" -$newArrow("2026-11-18b")-> "0..1" GasGiant : at
GasGiant "1" *-$newArrow("2026-11-18b")- "*" Satellite : satellites {ordered}
Satellite --> SatelliteKind

' Zeit und Reisen

' Charaktererschaffung und Lebenslauf

' Laufbahnen (Referenzdaten)

' Subsektor und Welten
Hex "1" *-- "1" Uwp : uwp
Hex --> WorldStep
WorldRoll "*" --> "1" Hex : for
WorldRoll ..> Hex : on roll
Hex "*" --> "*" TradeCode : /trade
Hex "*" --> "0..1" Temperature : temperature
Hex "1" *-- "0..1" Surface : surface

