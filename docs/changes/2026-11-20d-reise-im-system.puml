' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!$change = "2026-11-20d"
' Markierung offener Änderungen (siehe Skill domain-model, „Ausschnitte und Markierungen“).
' Ein Kennzeichen wie "2026-11-06" steht an allem, was eine noch nicht freigegebene Änderung
' bringt oder streicht; nach der Freigabe kommen die Kennzeichen wieder heraus. Rot ist also immer,
' was noch nicht freigegeben ist. Ein Änderungsausschnitt setzt $change auf sein Kennzeichen und
' zeigt nur diese Änderung rot; sonst ist alles Offene rot.
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Änderung 2026-11-20d: Reise im System: Logeintrag SystemJourney von Welt zu Welt mit Ticket (Buchung ticket) oder eigenem Schiff; Nebenwelten mit Namen, Oberfläche und Globus
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Booking $shop {
    at: datetime
    kind: BookingKind
    amount: number
    count: number [0..1]
    text: string [0..1]
    shipCost: ShipCost [0..1]
  }
  enum BookingKind <<value>> $shop {
    income
    expense
    deposit
    payout
    purchase
    sale
    lottery
    rent
    fare
    ship
    $new("2026-11-20d", "ticket")
  }
  class Character $charakter {
    name: string
    background: string
    equipment: string
    credits: number
    note: string
    dead: boolean
    retired: boolean
    npc: boolean
    role: NpcRole [0..1]
    /wounds: Wounds
    /hurt: number [0..1]
    /state: WoundState
    /blows: number [0..1]
  }
  enum NpcRole <<value>> $charakter
  class Upp <<value>> $charakter
  class SkillLevel $charakter

' Schiffe
  class Ship $schiffe {
    name: string
    fuel: number
    cargo: number
    price: number
    initialLoan: number [0..1]
    loanBalance: number [0..1]
    /monthlyPayment: number [0..1]
    nextPaymentDay: number [0..1]
    berthedSince: number [0..1]
    retired: boolean
  }
  class ShipSoftware $schiffe
  class ShipDesign <<reference>> $schiffe

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)

' Charaktererschaffung und Lebenslauf

' Subsektor und Welten
  class Hex $sektor
  class World $sektor {
    kind: WorldKind
    name: string [0..1]
    note: string [0..1]
    populationMultiplier: number [0..1]
    orbit: number [0..1]
    angle: number [0..1]
    captured: boolean
    diameter: number [0..1]
    large: boolean [0..1]
    radius: number [0..1]
    spaceport: Spaceport [0..1]
    facilities: Facility [*]
    bases: BaseKind [*]
    /main: boolean
    /zone: Zone [0..1]
    /gravity: number
  }
  enum WorldKind <<value>> $sektor
  enum Spaceport <<value>> $sektor
  enum BaseKind <<value>> $sektor
  enum Facility <<value>> $sektor
  class Uwp <<value>> $sektor

' Missionen

' Verlauf
  abstract class LogEntry $probe {
    at: datetime
    day: number [0..1]
  }
  class DiceRoll $probe
  class Note $probe

' Zeit und Reisen
  class Journey $reise
  class SystemJourney $reise $newClass("2026-11-20d") {
    hours: number
    /days: number
    /distance: number
  }

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class TaskResult $probe

' Referenzdaten
  class Item <<reference>> $shop
  class Surface <<value>> $sektor
' Fahrzeuge und Wege auf der Oberfläche
  class Temperature <<reference>> $sektor
  class TradeCode <<reference>> $sektor

' Kampagne
Booking "*" --> "0..1" Character : for
Booking "*" --> "0..1" Item : bought
Booking "*" --> "0..1" Item : sold
Booking "*" --> "0..1" World : in
Booking --> BookingKind

' Schiffe
Ship "*" --> "1" ShipDesign : design
Ship "1" *-- "0..*" ShipSoftware : software
