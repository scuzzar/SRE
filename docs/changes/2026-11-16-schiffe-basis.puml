' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!$change = "2026-11-16"
' Markierung offener Änderungen (siehe Skill domain-model, „Ausschnitte und Markierungen“).
' Ein Kennzeichen wie "2026-11-06" steht an allem, was eine noch nicht freigegebene Änderung
' bringt oder streicht; nach der Freigabe kommen die Kennzeichen wieder heraus. Rot ist also immer,
' was noch nicht freigegeben ist. Ein Änderungsausschnitt setzt $change auf sein Kennzeichen und
' zeigt nur diese Änderung rot; sonst ist alles Offene rot.
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Änderung 2026-11-16: Schiffe als Basis der Gruppe: Standardentwürfe, Kauf, Bankfinanzierung, Ship-Vorteil der Abmusterung
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne {
    name: string
    key: string
    changedAt: datetime
    /funds: number
    quantityDie: number [0..1]
    /load: number
    /capacity: number
    /burden: number
    day: number
    /date: string
    /weekday: number [0..1]
  }
  class Booking $shop {
    at: datetime
    kind: BookingKind
    amount: number
    count: number [0..1]
    text: string [0..1]
  }
  enum BookingKind <<value>> $shop {
    income
    expense
    deposit
    payout
    purchase
    sale
    lottery
    rent
    fare
    $new("2026-11-16", "ship")
  }

' Schiffe
  class Ship $schiffe $newClass("2026-11-16") {
    $new("2026-11-16", "name: string")
    $new("2026-11-16", "fuel: number")
    $new("2026-11-16", "cargo: number")
    $new("2026-11-16", "price: number")
    $new("2026-11-16", "initialLoan: number [0..1]")
    $new("2026-11-16", "loanBalance: number [0..1]")
    $new("2026-11-16", "/monthlyPayment: number [0..1]")
    $new("2026-11-16", "nextPaymentDay: number [0..1]")
  }
  class ShipDesign <<reference>> $schiffe $newClass("2026-11-16") {
    $new("2026-11-16", "code: string")
    $new("2026-11-16", "name: string")
    $new("2026-11-16", "hull: number")
    $new("2026-11-16", "jump: number")
    $new("2026-11-16", "maneuver: number")
    $new("2026-11-16", "fuel: number")
    $new("2026-11-16", "computer: string")
    $new("2026-11-16", "staterooms: number")
    $new("2026-11-16", "lowBerths: number")
    $new("2026-11-16", "hardpoints: number")
    $new("2026-11-16", "cargo: number")
    $new("2026-11-16", "crew: string")
    $new("2026-11-16", "basePrice: number")
    $new("2026-11-16", "months: number")
    $new("2026-11-16", "streamlined: boolean")
  }

' Charaktererschaffung und Lebenslauf
  class Career $erschaffung
  class CareerRoll $erschaffung {
    kind: RollKind
    dice: number[1..2]
    dm: number
    target: number [0..1]
    wants: boolean [0..1]
    /success: boolean [0..1]
    $new("2026-11-16", "shipChoice: ShipChoice [0..1]")
  }

' Subsektor und Welten

' Verlauf

' Zeit und Reisen

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Conflict <<transient>> $kampagne

' Referenzdaten
  class Service <<reference>> $erschaffung
  class Rank <<reference>> $erschaffung
  class Table <<reference>> $erschaffung
  class Gain <<reference>> $erschaffung {
    change: number [0..1]
    credits: number [0..1]
    weapon: boolean
    $new("2026-11-16", "shipDebtFree: boolean [0..1]")
  }
  class Item <<reference>> $shop
  class Cascade <<reference>> $erschaffung
' Fahrzeuge und Wege auf der Oberfläche
  class Aging <<reference>> $erschaffung
  enum RollKind <<value>> $erschaffung
  enum ShipChoice <<value>> $erschaffung $newClass("2026-11-16") {
    $new("2026-11-16", "keep")
    $new("2026-11-16", "switch")
  }

' Kampagne
Campaign "1" *-- "*" Booking : bookings {ordered}
Conflict "*" --> "0..1" Campaign : local
Conflict "*" --> "0..1" Campaign : remote
Booking "*" --> "0..1" Item : bought
Booking "*" --> "0..1" Item : sold
Booking --> BookingKind

' Schiffe
Campaign "1" *-$newArrow("2026-11-16")-- "0..1" Ship : ship
Ship "*" -$newArrow("2026-11-16")-> "1" ShipDesign : design
Booking "*" -$newArrow("2026-11-16")-> "0..1" Ship : forShip
Gain "*" -$newArrow("2026-11-16")-> "0..1" ShipDesign : ship

' Zeit und Reisen

' Charaktererschaffung und Lebenslauf
Career "1" *-- "*" CareerRoll : rolls {ordered}
CareerRoll --> RollKind
CareerRoll -$newArrow("2026-11-16")-> "0..1" ShipChoice
CareerRoll "*" --> "0..1" Service : for
CareerRoll "*" --> "0..1" Table : on
CareerRoll "*" --> "0..1" Gain : gained
CareerRoll "*" --> "0..1" Aging : against

' Laufbahnen (Referenzdaten)
Service "1" *-- "0..1" Gain : onEnlistment
Rank "1" *-- "0..1" Gain : grants
Table "1" *-- "6..7" Gain : rows {ordered}
Gain "*" --> "0..1" Cascade : choose
Gain "*" --> "0..1" Item : item

