    dex: number
    end: number
    int: number
    edu: number
    soc: number
  }
  class SkillLevel $charakter {
    level: number
    retired: boolean
  }
  class Possession $shop {
    count: number
    rounds: number [0..1]
  }

' Charaktererschaffung und Lebenslauf
  class Generation $erschaffung {
    /step: GenerationStep
  }
