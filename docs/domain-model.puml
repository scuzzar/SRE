    kind: BookingKind
    amount: number
    count: number [0..1]
    text: string [0..1]
  }
  enum BookingKind <<value>> $shop {
    income
    expense
    deposit
    payout
    purchase
    sale
  }
  class Character $charakter {
    name: string
    background: string
    equipment: string
