' Das Domänenmodell der Solo RPG Engine. Es führt: der Code folgt ihm, nie umgekehrt.
' Rendern: bash .claude/skills/domain-model/scripts/render.sh docs/domain-model.puml
@startuml
!pragma layout smetana
title Solo RPG Engine – Domänenmodell (Version 1)
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype

' Kampagne und Charaktere
  class Campaign {
    name: string
    /funds: number
  }
  class Booking {
    at: datetime
    kind: BookingKind
    amount: number
    count: number [0..1]
    text: string [0..1]
  }
  enum BookingKind <<value>> {
    income
    expense
    deposit
    payout
    purchase
    sale
  }
  class Character {
    name: string
    background: string
    equipment: string
    credits: number
    note: string
    dead: boolean
    retired: boolean
  }
  class Upp <<value>> {
    str: number
    dex: number
    end: number
    int: number
    edu: number
    soc: number
  }
  class SkillLevel {
    level: number
    retired: boolean
  }
  class Possession {
    count: number
    rounds: number [0..1]
  }

' Charaktererschaffung und Lebenslauf
  class Generation {
    /step: GenerationStep
  }
  class Career {
    /terms: number
    /rank: number
    /age: number
    /drafted: boolean
    /dead: boolean
    /pension: number
  }
  class CareerRoll {
    kind: RollKind
    dice: number[1..2]
    dm: number
    target: number [0..1]
    wants: boolean [0..1]
    /success: boolean [0..1]
  }

' Subsektor und Welten
  class Hex {
    column: number
    row: number
    empty: boolean
    name: string [0..1]
    navalBase: boolean [0..1]
    scoutBase: boolean [0..1]
    gasGiant: boolean [0..1]
    note: string [0..1]
    /step: WorldStep
  }
  class Uwp <<value>> {
    starport: number [0..1]
    size: number [0..1]
    atmosphere: number [0..1]
    hydrographics: number [0..1]
    population: number [0..1]
    government: number [0..1]
    law: number [0..1]
    tech: number [0..1]
  }
  class WorldRoll <<transient>> {
    kind: WorldRollKind
    dice: number[1..2]
    dm: number
    target: number [0..1]
    /value: number [0..1]
    /success: boolean [0..1]
  }

' Verlauf
  abstract class LogEntry {
    at: datetime
  }
  class OracleAnswer {
    question: string [0..1]
    roll: number
    chance: number
    /yes: boolean
  }
  class DiceRoll {
    dice: number[2]
    /total: number
  }
  class CardPick {
    question: string [0..1]
    bell: number [0..1]
    scatter: Scatter [0..1]
  }
  class PickedItem
  class Note {
    text: string
  }

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Card <<transient>> {
    question: string [0..1]
    bell: number
    scatter: Scatter
    pickedRolls: CardRoll [*]
  }
  class MapIcon <<value>> {
    north: PathKind
    east: PathKind
    south: PathKind
    west: PathKind
    up: PathKind
    down: PathKind
  }
  enum PathKind <<value>> {
    none
    path
    deadEnd
    hidden
    obstacle
  }
  enum Scatter <<value>> {
    n
    ne
    e
    se
    s
    sw
    w
    nw
    hit
    miss
  }
  enum CardRoll <<value>> {
    bell
    scatter
    map
  }
  class Task <<transient>> {
    unskilled: boolean
    /dm: number
    /need: number
    /chance: number
  }
  class TaskResult {
    dice: number[2]
    dm: number
    target: number
    /success: boolean
  }
  class Attack <<transient>> {
    armor: ArmorClass [0..1]
    range: Range [0..1]
    /dm: number
    /need: number
    /chance: number
  }
  class AttackResult {
    armor: ArmorClass
    range: Range
    dice: number[2]
    dm: number
    target: number
    /success: boolean
  }
  class DamageRoll {
    dice: number[1..5]
    /damage: number
  }

' Referenzdaten
  class Odds <<reference>> {
    name: string
    chance: number
    target: number
  }
  class HouseRules <<reference>> {
    unskilledDm: number
    bonusFrom: number
    malusUpTo: number
  }
  class Skill <<reference>> {
    name: string
    short: string
  }
  class Section <<reference>> {
    name: string
    kind: SectionKind
  }
  class Slot <<reference>> {
    label: string
  }
  class Column <<reference>>
  class Entry <<reference>> {
    text: string
    retired: boolean
  }
  class Service <<reference>> {
    name: string
    draft: number
    reenlist: number
    skillsPerTerm: number [0..1]
  }
  class Throw <<value>> {
    target: number
  }
  class ThrowDm <<value>> {
    atLeast: number
    dm: number
  }
  class Rank <<reference>> {
    level: number
    title: string
  }
  class Table <<reference>> {
    name: string
    minEdu: number [0..1]
  }
  class Gain <<reference>> {
    change: number [0..1]
    credits: number [0..1]
    weapon: boolean
  }
  class Item <<reference>> {
    name: string
    kind: ItemKind
    tl: number [0..1]
    weight: number [0..1]
    price: number [0..1]
    once: boolean
  }
  class Weapon <<reference>> {
    name: string
    attack: AttackKind
    required: number
    requiredDm: number
    advantageous: number
    advantageousDm: number
    wounds: number
    rounds: number [0..1]
    law: number [0..1]
  }
  class ArmorDm <<value>> {
    armor: ArmorClass
    dm: number
  }
  class RangeDm <<value>> {
    range: Range
    dm: number [0..1]
  }
  enum AttackKind <<value>> {
    blow
    swing
    shot
  }
  enum ArmorClass <<value>> {
    nothing
    jack
    mesh
    cloth
    reflec
    ablat
    combat
  }
  enum Range <<value>> {
    close
    short
    medium
    long
    veryLong
  }
  enum ItemKind <<value>> {
    weapon
    ammunition
    armor
    equipment
    vehicle
    ship
    passage
    membership
  }
  class Cascade <<reference>> {
    name: string
  }
  class SystemContents <<reference>> {
    roll: number
    starport: string
    navalBase: boolean
    scoutBase: boolean
    gasGiant: boolean
  }
  class UwpDigit <<reference>> {
    digit: number
    text: string [0..1]
    techDm: number
    temperatureDm: number [0..1]
  }
  class Surface <<value>> {
    water: number
    plates: number
    majorContinents: number
    minorContinents: number
    majorIslands: number
    archipelagos: number
    majorOceans: number
    minorOceans: number
    smallSeas: number
    scatteredLakes: number
    life: boolean
  }
  class SurfaceRow <<reference>> {
    table: SurfaceTable
    roll: number
    major: DiceExpr
    minor: DiceExpr
    small: DiceExpr
    scattered: DiceExpr
    onlyScattered: boolean
  }
  enum SurfaceTable <<value>> {
    continents
    oceans
  }
  class DiceExpr <<value>> {
    dice: number
    dm: number
  }
  class Temperature <<reference>> {
    from: number [0..1]
    to: number [0..1]
    name: string
    average: string
    text: string
    hydroDm: number
  }
  class TradeCode <<reference>> {
    code: string
    name: string
  }
  class TradeCondition <<value>> {
    digits: number[]
  }
  enum WorldRollKind <<value>> {
    occurrence
    starport
    navalBase
    scoutBase
    gasGiant
    size
    atmosphere
    temperature
    hydrographics
    population
    government
    law
    tech
  }
  enum WorldStep <<value>> {
    <i>alle Arten aus WorldRollKind</i>
    surface
    name
    done
  }
  class Aging <<reference>> {
    fromTerm: number
    loss: number
    target: number
  }
  enum RollKind <<value>> {
    characteristic
    enlistment
    draft
    survival
    commission
    promotion
    skill
    aging
    crisis
    reenlist
    cash
    benefit
  }
  enum GenerationStep <<value>> {
    characteristics
    homeworld
    service
    draft
    world
    survival
    commission
    promotion
    skill
    cascade
    aging
    crisis
    reenlist
    muster
    name
    dead
  }
  enum SectionKind <<value>> {
    card
    theme
  }
  enum Characteristic <<value>> {
    STR
    DEX
    END
    INT
    EDU
    SOC
  }

' Kampagne
Campaign "1" *-- "*" Character : characters
Campaign "*" --> "1" Odds : odds
Campaign "0..1" --> "0..1" Character : focus
Campaign "1" *-- "*" LogEntry : log {ordered}
Campaign "*" --> "0..1" Hex : location
Campaign "1" *-- "*" Booking : bookings {ordered}
Booking "*" --> "0..1" Character : for
Booking "*" --> "0..1" Item : bought
Booking "*" --> "0..1" Item : sold
Booking "*" --> "0..1" Hex : in
Booking --> BookingKind

' Charaktererschaffung und Lebenslauf
Campaign "1" *-- "0..1" Generation : generation
Generation "1" *-- "1" Career : career
Generation ..> Character : on finish
Generation --> GenerationStep
Character "1" *-- "0..1" Career : career
Career "1" *-- "*" CareerRoll : rolls {ordered}
Career "*" --> "0..1" Service : /in
Career "*" --> "0..1" Hex : homeworld
Career "*" --> "*" Hex : worlds {ordered}
Character "*" --> "0..1" Hex : homeworld
CareerRoll --> RollKind
CareerRoll --> "0..1" Characteristic : of
CareerRoll "*" --> "0..1" Service : for
CareerRoll "*" --> "0..1" Table : on
CareerRoll "*" --> "0..1" Gain : gained
CareerRoll "*" --> "0..1" Skill : chosen
CareerRoll "*" --> "0..1" Aging : against

' Laufbahnen (Referenzdaten)
Service "1" *-- "1" Throw : enlistment
Service "1" *-- "1" Throw : survival
Service "1" *-- "0..1" Throw : commission
Service "1" *-- "0..1" Throw : promotion
Throw "1" *-- "0..2" ThrowDm : dms
ThrowDm --> "1" Characteristic : if
Service "1" *-- "0..6" Rank : ranks {ordered}
Service "1" *-- "4" Table : skills {ordered}
Service "1" *-- "1" Table : benefits
Service "1" *-- "1" Table : cash
Service "1" *-- "0..1" Gain : onEnlistment
Rank "1" *-- "0..1" Gain : grants
Table "1" *-- "6..7" Gain : rows {ordered}
Gain "*" --> "0..1" Skill : skill
Gain "*" --> "0..1" Cascade : choose
Gain "*" --> "0..1" Item : item
Gain --> "0..1" Characteristic : changes
Cascade "*" --> "1..*" Skill : options
Aging --> "1" Characteristic : of

' Subsektor und Welten
Campaign "1" *-- "*" Hex : hexes
Hex "1" *-- "1" Uwp : uwp
Hex --> WorldStep
WorldRoll "*" --> "1" Hex : for
WorldRoll ..> Hex : on roll
Hex "*" --> "*" TradeCode : /trade
Hex "*" --> "0..1" Temperature : temperature
Hex "1" *-- "0..1" Surface : surface
Surface "*" --> "0..1" SurfaceRow : /row
SurfaceRow --> SurfaceTable
SurfaceRow -[hidden]- DiceExpr
WorldRoll --> WorldRollKind
WorldRoll "*" --> "0..1" SystemContents : /row
UwpDigit --> "1" WorldRollKind : of
TradeCode "1" *-- "1..*" TradeCondition : if
TradeCondition --> "1" WorldRollKind : of

' Charakter
Character "1" *-- "1" Upp : upp
Character "1" *-- "*" SkillLevel : skills
SkillLevel "*" --> "1" Skill : of
Character "1" *-- "*" Possession : possessions
Possession "*" --> "1" Item : of
Item --> ItemKind
Item "0..1" --> "0..1" Skill : /uses
Item "0..1" --> "0..1" Weapon : weapon
Character "*" --> "0..1" Weapon : wields

' Waffen (Referenzdaten)
Weapon "*" --> "1" Skill : uses
Weapon "*" --> "0..1" Item : ammo
Hex "*" --> "*" Item : /offer
Weapon --> AttackKind
Weapon "1" *-- "7" ArmorDm : vsArmor {ordered}
Weapon "1" *-- "5" RangeDm : atRange {ordered}
ArmorDm -[hidden]- ArmorClass
RangeDm -[hidden]- Range

' Verlauf
LogEntry <|-- OracleAnswer
LogEntry <|-- DiceRoll
LogEntry <|-- CardPick
LogEntry <|-- TaskResult
LogEntry <|-- AttackResult
LogEntry <|-- DamageRoll
LogEntry <|-- Note
Note "*" --> "0..1" LogEntry : interprets
CardPick "1" *-- "*" PickedItem : items {ordered}
CardPick "1" *-- "0..1" MapIcon : map
OracleAnswer "*" --> "1" Odds : odds
TaskResult "*" --> "1" Character : for
TaskResult "*" --> "0..1" SkillLevel : uses
TaskResult --> "0..6" Characteristic : counts
TaskResult "*" --> "1" Odds : odds

' Probe
Task "0..1" --> "1" Campaign : in
Task "*" --> "1" Character : /for
Task "*" --> "0..1" SkillLevel : uses
Task --> "0..6" Characteristic : counts
Task ..> TaskResult : on roll

' Angriff
Attack "0..1" --> "1" Campaign : in
Attack "*" --> "1" Character : /for
Attack "*" --> "1" Weapon : /with
Attack ..> AttackResult : on roll
AttackResult "*" --> "1" Character : for
AttackResult "*" --> "1" Weapon : with
AttackResult "*" --> "0..1" SkillLevel : uses
DamageRoll "0..1" --> "1" AttackResult : of

' Karte
Card "0..1" --> "1" Campaign : in
Card "*" --> "1..*" Entry : drawn {ordered}
Card "*" --> "*" Slot : picked
Card ..> CardPick : on confirm
Card "1" *-- "1" MapIcon : map
PickedItem "*" --> "1" Slot : /in
PickedItem "*" --> "1..2" Entry : picked {ordered}
Section "1" *-- "1..*" Slot : slots {ordered}
Section --> SectionKind
Slot "1" *-- "1..2" Column : columns {ordered}
Column "1" *-- "1..*" Entry : entries


legend right
  |<#e8ecfb> <color:#5b64b8>████</color> | Spielstand, wird gespeichert |
  |<#f4f4f4> <color:#8a8a8a>╌╌╌╌</color> | Flüchtig: zwischen zwei Eingaben da, nie gespeichert |
  |<#e6f4e6> <color:#4f9a4f>████</color> | Referenzdaten: Tabellen, in jeder Kampagne gleich |
  |<#ffffff> <color:#8a8a8a>□□□□</color> | Wert oder Werteliste |
endlegend
@enduml
