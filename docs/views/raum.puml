' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Raumkarte und Systemflug
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne
  class Character $charakter

' Schiffe
  class Ship $schiffe
  class ShipWeapon <<reference>> $schiffe
  class ShipDesign <<reference>> $schiffe

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)
  class SystemFlight $raum {
    startedAt: datetime
    round: number
    phase: BattlePhase
    /elapsed: number
  }
  class StarSystem $raum {
    maxOrbits: number
    emptyOrbits: number [*]
  }
  class Star $raum {
    type: StarType
    decimal: number [0..1]
    size: StarSize
    orbit: number [0..1]
    close: boolean
    farAu: number [0..1]
  }
  enum StarType <<value>> $raum {
    O
    B
    A
    F
    G
    K
    M
  }
  enum StarSize <<value>> $raum {
    Ia
    Ib
    II
    III
    IV
    V
    VI
    D
  }
  enum Zone <<value>> $raum {
    inner
    habitable
    outer
  }
  class StarZones <<reference>> $raum {
    type: StarType
    decimal: number [0..1]
    size: StarSize
    firstOrbit: number
    habitableOrbit: number [0..1]
  }
  class Skimming $raum {
    tons: number
  }
  class ShipDamage <<value>> $raum {
    hits: HitZone [*]
    patched: number [*]
    turretsOut: number [*]
    /maneuver: number
    /jump: number
    /disabled: boolean
    /destroyed: boolean
  }
  enum HitZone <<value>> $raum {
    powerPlant
    maneuver
    jump
    fuel
    hull
    hold
    computer
    turret
    criticalPowerPlant
    criticalManeuver
    criticalJump
    crew
    criticalComputer
    explode
    drive
    cabin
    weapons
    criticalDrive
  }
  enum Intent <<value>> $raum {
    attack
    flee
    ignore
  }
  enum BattlePhase <<value>> $raum {
    thrust
    fire
  }
  class SpaceBattle $raum {
    foe: string
    intent: Intent
    encounter: number[2] [0..1]
    reaction: number[2] [0..1]
    attack: number[2] [0..1]
    occasion: EncounterOccasion [0..1]
  }
  enum EncounterOccasion <<value>> $raum {
    departure
    arrival
  }
  class EncounterCheck <<transient>> $raum {
    occasion: EncounterOccasion [0..1]
    /column: string
    /dm: number
    /shipOn: number [*]
  }
  class SpaceAttack $raum {
    round: number
    attacker: string
    target: string
    turret: number
    dice: number[2]
    dm: number
    bands: number
    computerHits: number
    noComputer: boolean
    predict: number
    gunnery: number
    evade: number
    returnFire: boolean
    /hit: boolean
    hits: HitZone [*]
  }
  class SpaceBattleEnd $raum {
    foe: string
    outcome: BattleOutcome
  }
  enum BattleOutcome <<value>> $raum {
    destroyed
    disabled
    escaped
    broken
    lost
    departed
  }
  class SpaceUnit $raum {
    position: Vec
    velocity: Vec
    thrust: Vec [0..1]
    crashed: boolean
    name: string [0..1]
    intent: Intent [0..1]
    firedTurrets: number [0..*]
    returned: boolean
    docking: boolean
    /maxG: number
    /evading: boolean
  }
  class DamageControl $raum {
    round: number
    unit: string
    dice: number[2]
    dm: number
    zone: HitZone
    /success: boolean
  }
  class TrackPoint <<value>> $raum {
    position: Vec
    velocity: Vec
  }
  class Vec <<value>> $raum {
    x: number
    y: number
  }

' Charaktererschaffung und Lebenslauf

' Subsektor und Welten
  class Hex $sektor
  class World $sektor

' Missionen

' Verlauf
  abstract class LogEntry $probe

