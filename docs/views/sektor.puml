' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Subsektor und Welten
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne
  class Booking $shop
  class Character $charakter

' Schiffe
  class Ship $schiffe

' Handel (Regeln: docs/regeln-handel.md)
  class Market $handel
  class GoodsRoll $handel
  class PriceRoll $handel
  class Cargo $handel
  class Fare $handel $newClass("2026-11-27c")
  class MessageOffer <<value>> $handel
  class FreightOffer <<value>> $handel
  class PassengerOffer <<value>> $handel
  enum TravelZone <<value>> $handel
  class TradeDm <<value>> $handel

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)
  class SystemFlight $raum
  class StarSystem $raum
  class Skimming $raum
  class SpaceBattle $raum
  class EncounterCheck <<transient>> $raum

' Charaktererschaffung und Lebenslauf
  class Career $erschaffung

' Subsektor und Welten
  class Hex $sektor {
    column: number
    row: number
    empty: boolean
    navalBase: boolean [0..1]
    scoutBase: boolean [0..1]
    gasGiant: boolean [0..1]
    travelZone: TravelZone [0..1]
    /step: WorldStep
  }
  class World $sektor {
    kind: WorldKind
    name: string [0..1]
    note: string [0..1]
    populationMultiplier: number [0..1]
    orbit: number [0..1]
    angle: number [0..1]
    captured: boolean
    diameter: number [0..1]
    large: boolean [0..1]
    radius: number [0..1]
    spaceport: Spaceport [0..1]
    facilities: Facility [*]
    bases: BaseKind [*]
    /main: boolean
    /zone: Zone [0..1]
    /gravity: number
  }
  enum WorldKind <<value>> $sektor {
    world
    small
    belt
    giant
    ring
  }
  enum Spaceport <<value>> $sektor {
    F
    G
    H
    Y
  }
  enum BaseKind <<value>> $sektor {
    naval
    scout
  }
  enum Facility <<value>> $sektor {
    farming
    mining
    colony
    research
    military
  }
  class Uwp <<value>> $sektor {
    starport: number [0..1]
    size: number [0..1]
    atmosphere: number [0..1]
    hydrographics: number [0..1]
    population: number [0..1]
    government: number [0..1]
    law: number [0..1]
    tech: number [0..1]
  }
  class WorldRoll <<transient>> $sektor {
    kind: WorldRollKind
    dice: number[1..2]
    dm: number
    target: number [0..1]
    /value: number [0..1]
    /success: boolean [0..1]
  }

' Missionen

' Verlauf

' Zeit und Reisen
  class Journey $reise
  class SystemJourney $reise

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Encounter $begegnung
  class AnimalTable $begegnung

' Referenzdaten
  class Item <<reference>> $shop
  class SystemContents <<reference>> $sektor {
    roll: number
    starport: string
    navalBase: boolean
    scoutBase: boolean
    gasGiant: boolean
  }
  class UwpDigit <<reference>> $sektor {
    digit: number
    text: string [0..1]
    techDm: number
    temperatureDm: number [0..1]
  }
  class Surface <<value>> $sektor {
    water: number
    plates: number
    majorContinents: number
    minorContinents: number
    majorIslands: number
    archipelagos: number
    majorOceans: number
    minorOceans: number
    smallSeas: number
    scatteredLakes: number
    life: boolean
  }
  class SurfaceMap $oberflaeche
  class Place <<value>> $oberflaeche
' Fahrzeuge und Wege auf der Oberfläche
  class SurfaceRow <<reference>> $sektor {
    table: SurfaceTable
    roll: number
    major: DiceExpr
    minor: DiceExpr
    small: DiceExpr
    scattered: DiceExpr
    onlyScattered: boolean
  }
  enum SurfaceTable <<value>> $sektor {
    continents
    oceans
  }
  class DiceExpr <<value>> $sektor {
    dice: number
    dm: number
    less: number [0..1]
    times: number [0..1]
  }
  class Temperature <<reference>> $sektor {
    from: number [0..1]
    to: number [0..1]
    name: string
    average: string
    text: string
    hydroDm: number
  }
  class TradeCode <<reference>> $sektor {
    code: string
    name: string
  }
  class TradeCondition <<value>> $sektor {
    digits: number[]
  }
  enum WorldRollKind <<value>> $sektor {
    occurrence
    starport
    navalBase
    scoutBase
    gasGiant
    size
    atmosphere
    temperature
    hydrographics
    population
    government
    law
    tech
  }
  enum WorldStep <<value>> $sektor {
    <i>alle Arten aus WorldRollKind</i>
    surface
    system
    name
    done
  }
  ' Was ein verworfener Lauf eines NSC gab; die Wartenscheibe zählt mit.

' Kampagne
Booking "*" --> "0..1" World : in

' Schiffe

' Handel
Market "*" --> "1" World : at
FreightOffer "*" --> "1" Hex : to
PassengerOffer "*" --> "1" Hex : to
MessageOffer "*" -$goneArrow("2026-11-27c")-> "0..1" Hex : to
MessageOffer "*" -$newArrow("2026-11-27c")-> "1" Hex : to
GoodsRoll "*" --> "1" World : at
PriceRoll "*" --> "1" World : at
Ship "*" -$goneArrow("2026-11-27c")-> "0..1" Hex : destination
Fare "*" -$newArrow("2026-11-27c")-> "1" World : from
Fare "*" -$newArrow("2026-11-27c")-> "1" Hex : to
Cargo "*" --> "1" World : from
Cargo "*" --> "0..1" Hex : to
Hex --> TravelZone
