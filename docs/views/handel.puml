' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Handel
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne
  class Booking $shop
  class Character $charakter

' Schiffe
  class Ship $schiffe

' Handel (Regeln: docs/regeln-handel.md)
  class Market $handel $newClass("2026-11-27") {
    week: number
    /current: boolean
  }
  class GoodsRoll $handel $newClass("2026-11-27") {
    dice: number[2]
    dm: number
    quantityDice: number[*]
    /quantity: number
  }
  class PriceRoll $handel $newClass("2026-11-27") {
    sale: boolean
    dice: number[2]
    tradeDm: number
    skillDm: number
    brokerDm: number
    /percent: number
    /price: number
  }
  class Cargo $handel $newClass("2026-11-27") {
    kind: CargoKind
    tons: number
    count: number [0..1]
    paid: number [0..1]
    fee: number [0..1]
    retired: boolean
  }
  enum CargoKind <<value>> $handel $newClass("2026-11-27") {
    goods
    freight
    message
  }
  class MessageOffer <<value>> $handel $newClass("2026-11-27") {
    dice: number[2]
    /available: boolean
    die: number
    /fee: number
    taken: boolean
  }
  class FreightOffer <<value>> $handel $newClass("2026-11-27") {
    dice: number[3]
    dm: number
  }
  class FreightLot <<value>> $handel $newClass("2026-11-27") {
    size: FreightSize
    die: number
    /tons: number
    taken: boolean
  }
  enum FreightSize <<value>> $handel $newClass("2026-11-27") {
    major
    minor
    incidental
  }
  class PassengerOffer <<value>> $handel $newClass("2026-11-27") {
    highDice: number[*]
    middleDice: number[*]
    lowDice: number[*]
    dm: number
    /high: number
    /middle: number
    /low: number
    high: number
    middle: number
    low: number
  }
  enum ShipIncome <<value>> $handel $newClass("2026-11-27") {
    freight
    passage
    goods
    mail
    message
  }
  enum TravelZone <<value>> $handel $newClass("2026-11-27") {
    amber
    red
  }
  class TradeGood <<reference>> $handel $newClass("2026-11-27") {
    roll: number
    name: string
    basePrice: number
    quantity: DiceExpr
    perItem: boolean
    tonsPerItem: number [0..1]
  }
  class TradeDm <<value>> $handel $newClass("2026-11-27") {
    dm: number
  }
  class ActualValue <<reference>> $handel $newClass("2026-11-27") {
    roll: number
    percent: number
  }
  class CargoRow <<reference>> $handel $newClass("2026-11-27") {
    population: number
    major: DiceExpr [0..1]
    minor: DiceExpr [0..1]
    incidental: DiceExpr [0..1]
  }
  class PassengerRow <<reference>> $handel $newClass("2026-11-27") {
    population: number
    high: DiceExpr [0..1]
    middle: DiceExpr [0..1]
    low: DiceExpr [0..1]
  }

