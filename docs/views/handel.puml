Cargo "*" --> "1" World : from
Cargo "*" --> "0..1" Hex : to
Booking "*" --> "0..1" Cargo : forCargo
Booking --> ShipIncome
Hex --> TravelZone
TradeGood "1" *-- "*" TradeDm : purchase
TradeGood "1" *-- "*" TradeDm : resale
