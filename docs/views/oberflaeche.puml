' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Oberflächenkarte
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne
  class Character $charakter
  class Possession $shop

' Schiffe
  class Ship $schiffe

' Handel (Regeln: docs/regeln-handel.md)

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)
  class SpaceUnit $raum

' Charaktererschaffung und Lebenslauf

' Subsektor und Welten
  class World $sektor

' Missionen
  class MissionPlace <<value>> $mission

' Verlauf
  abstract class LogEntry $probe

' Zeit und Reisen

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Terrain <<reference>> $begegnung

' Referenzdaten
  class SurfaceMap $oberflaeche {
    /cells: number
  }
  class SurfaceCell <<value>> $oberflaeche {
    towns: number
  }
  enum Landform <<value>> $oberflaeche {
    water
    waterIce
    landIce
    tundra
    mountain
    rugged
    desert
    jungle
    swamp
    open
    settled
  }
  class River <<value>> $oberflaeche {
  }
  class Road <<value>> $oberflaeche {
  }
  enum Volcano <<value>> $oberflaeche {
    major
    field
  }
  class City $oberflaeche {
    name: string
    population: number
    multiplier: number
    rank: CityRank
    port: Port [0..1]
  }
  enum CityRank <<value>> $oberflaeche {
    primary
    secondary
  }
  enum Port <<value>> $oberflaeche {
    A
    B
    C
    D
    E
    F
    G
    H
  }
  class Place <<value>> $oberflaeche {
  }
' Fahrzeuge und Wege auf der Oberfläche
  class Vehicle <<reference>> $logistik
  class VehicleSpeed <<value>> $logistik
  class Trip $logistik
  class Leg <<value>> $logistik
  ' Was ein verworfener Lauf eines NSC gab; die Wartenscheibe zählt mit.

' Kampagne
Campaign "1" *-- "0..1" Place : location

' Schiffe
Ship "1" *-- "0..1" Place : place

' Handel

' Raumkarte und Systemflug
SpaceUnit "*" --> "0..1" City : dockAt

' Zeit und Reisen

' Charaktererschaffung und Lebenslauf
Character "1" *-- "0..1" Place : place
MissionPlace "1" *-- "1" Place : place

' Laufbahnen (Referenzdaten)

' Subsektor und Welten
World "1" *-- "0..1" SurfaceMap : map
SurfaceMap "1" *-- "/cells" SurfaceCell : cells {ordered}
SurfaceCell "*" --> "1" Landform : landform
SurfaceCell "*" --> "0..1" Volcano : volcano
SurfaceMap "1" *-- "*" River : rivers
SurfaceMap "1" *-- "*" Road : roads
SurfaceMap "1" *-- "*" City : cities
SurfaceMap "1" --> "0..1" City : highport
River "*" --> "2..*" SurfaceCell : cells {ordered}
Road "*" --> "2..*" SurfaceCell : cells {ordered}
City "*" --> "0..1" SurfaceCell : cell
LogEntry "1" *-- "0..1" Place : place
Place "*" --> "1" World : world
Place "*" --> "0..1" SurfaceCell : cell
Place "*" --> "0..1" City : city
City --> CityRank
City --> Port
VehicleSpeed "*" --> "0..1" Landform : on
Vehicle "*" --> "*" Landform : landsOn
Vehicle "*" --> "*" Port : landsAt
Leg "*" --> "1..*" SurfaceCell : cells {ordered}
Trip "*" --> "0..1" SurfaceCell : /at
Possession "1" *-- "0..1" Place : parked

' Charakter

' Waffen (Referenzdaten)

' Verlauf

' Probe

' Angriff

' Begegnung
Landform "*" --> "1" Terrain : terrain

' Karte


legend right
  |<#e8ecfb> <color:#5b64b8>████</color> | Spielstand, wird gespeichert |
  |<#f4f4f4> <color:#8a8a8a>╌╌╌╌</color> | Flüchtig: zwischen zwei Eingaben da, nie gespeichert |
  |<#e6f4e6> <color:#4f9a4f>████</color> | Referenzdaten: Tabellen, in jeder Kampagne gleich |
  |<#ffffff> <color:#8a8a8a>□□□□</color> | Wert oder Werteliste |
  |<#fdf1dc> <color:#b8862e>████</color> | Über Kampagnen hinweg: nicht im Spielstand, mit OneDrive abgeglichen, nicht exportiert |
endlegend
@enduml
