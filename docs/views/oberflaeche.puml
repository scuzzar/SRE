' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)

' Referenzdaten
  class SurfaceMap $oberflaeche $newClass("2026-11-14g") {
    landforms: Landform[]
    /cells: number
  }
  enum Landform <<value>> $oberflaeche $newClass("2026-11-14g") {
    water
    waterIce
    landIce
    tundra
    mountain
    rugged
    desert
    jungle
    swamp
    open
    settled
  }
  class River <<value>> $oberflaeche $newClass("2026-11-14g") {
    cells: number[2..*]
  }
  class Road <<value>> $oberflaeche $newClass("2026-11-14g") {
    cells: number[2..*]
  }
  class Volcano <<value>> $oberflaeche $newClass("2026-11-14g") {
    cell: number
    field: boolean
  }
  class City <<value>> $oberflaeche $newClass("2026-11-14g") {
    cell: number [0..1]
    population: number
    multiplier: number
    rank: CityRank
    port: Port [0..1]
  }
  enum CityRank <<value>> $oberflaeche $newClass("2026-11-14g") {
    primary
    secondary
  }
  enum Port <<value>> $oberflaeche $newClass("2026-11-14g") {
    A
    B
    C
    D
    E
    F
    G
    H
  }
  class Towns <<value>> $oberflaeche $newClass("2026-11-14g") {
    cell: number
    count: number
  }

