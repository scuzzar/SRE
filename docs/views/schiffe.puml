' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Schiffe
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne
  class Booking $shop

' Schiffe
  class Ship $schiffe {
    name: string
    fuel: number
    cargo: number
    price: number
    initialLoan: number [0..1]
    loanBalance: number [0..1]
    /monthlyPayment: number [0..1]
    nextPaymentDay: number [0..1]
    berthedSince: number [0..1]
    retired: boolean
  }
  enum ShipCost <<value>> $schiffe {
    price
    rate
    fuel
    berthing
    lifeSupport
  }
  class ShipSoftware $schiffe {
  }
  class ShipDesign <<reference>> $schiffe {
    code: string
    /jumpFuel: number
    name: string
    hull: number
    jump: number
    maneuver: number
    fuel: number
    staterooms: number
    lowBerths: number
    hardpoints: number
    cargo: number
    crew: string
    basePrice: number
    months: number
    streamlined: boolean
  }
  class ComputerModel <<reference>> $schiffe {
    name: string
    jump: number
    price: number
    tons: number
    cpu: number
    storage: number
    tl: number
    /softwareCredit: number
  }
  class Software <<reference>> $schiffe {
    name: string
    kind: SoftwareKind
    space: number
    price: number
    effect: string
    writeSkills: string [0..1]
  }
  enum SoftwareKind <<value>> $schiffe {
    offensive
    defensive
    routine
  }
  class DeckPlan <<browser>> $schiffe {
    key: string
    name: string
    image: string
  }

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)
  class SpaceUnit $raum

