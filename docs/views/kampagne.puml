' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Kampagne
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
  BackgroundColor<<browser>> #fdf1dc
  BorderColor<<browser>> #b8862e
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype
hide <<browser>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne {
    name: string
    key: string
    changedAt: datetime
    /funds: number
    /ship: Ship [0..1]
    quantityDie: number [0..1]
    /load: number
    /capacity: number
    /burden: number
    day: number
    /date: string
    /weekday: number [0..1]
  }
  class Booking $shop
  class Character $charakter
  class Possession $shop

' Schiffe
  class Ship $schiffe

' Raumkarte und Systemflug (Konzept: docs/konzept-raumkampf.md, Stufe 1)
  class SystemFlight $raum

' Charaktererschaffung und Lebenslauf
  class Generation $erschaffung

' Subsektor und Welten
  class Hex $sektor

' Missionen
  class Mission $mission

' Verlauf
  abstract class LogEntry $probe

' Zeit und Reisen
  class Voyage $reise

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Conflict <<transient>> $kampagne {
    /localChangedAt: datetime [0..1]
    /remoteChangedAt: datetime [0..1]
    /localLogCount: number [0..1]
    /remoteLogCount: number [0..1]
  }
  class Card <<transient>> $karte
  class Task <<transient>> $probe
  class Attack <<transient>> $kampf
  class Encounter $begegnung
  class Terrain <<reference>> $begegnung

' Referenzdaten
  class Odds <<reference>> $karte
  class Place <<value>> $oberflaeche
' Fahrzeuge und Wege auf der Oberfläche
  class Trip $logistik
  ' Was ein verworfener Lauf eines NSC gab; die Wartenscheibe zählt mit.

' Kampagne
Campaign "1" *-- "*" Character : characters
Campaign "*" -$goneArrow("2026-11-27")-> "1" Odds : odds
Campaign "0..1" --> "0..1" Character : focus
Campaign "1" *-- "*" LogEntry : log {ordered}
Campaign "1" *-- "0..1" Place : location
Campaign "1" *-- "*" Booking : bookings {ordered}
Conflict "*" --> "0..1" Campaign : local
Conflict "*" --> "0..1" Campaign : remote

' Schiffe
Campaign "1" *-- "0..*" Ship : ships

' Raumkarte und Systemflug
Campaign "1" *-- "0..1" SystemFlight : flight

' Zeit und Reisen
Campaign "1" *-- "0..1" Voyage : voyage

' Charaktererschaffung und Lebenslauf
Campaign "1" *-- "0..1" Generation : generation
Campaign "1" *-- "*" Mission : missions {ordered}

' Laufbahnen (Referenzdaten)

' Subsektor und Welten
Campaign "1" *-- "*" Hex : hexes
Campaign "1" *-- "0..1" Trip : trip

' Charakter
Campaign "1" *-- "*" Possession : stash

' Waffen (Referenzdaten)

' Verlauf

' Probe
Task "0..1" --> "1" Campaign : in

' Angriff
Attack "0..1" --> "1" Campaign : in

' Begegnung
Campaign "1" *-- "*" Encounter : encounters {ordered}
Campaign "*" --> "0..1" Terrain : terrain

' Karte
Card "0..1" --> "1" Campaign : in


legend right
  |<#e8ecfb> <color:#5b64b8>████</color> | Spielstand, wird gespeichert |
  |<#f4f4f4> <color:#8a8a8a>╌╌╌╌</color> | Flüchtig: zwischen zwei Eingaben da, nie gespeichert |
  |<#e6f4e6> <color:#4f9a4f>████</color> | Referenzdaten: Tabellen, in jeder Kampagne gleich |
  |<#ffffff> <color:#8a8a8a>□□□□</color> | Wert oder Werteliste |
  |<#fdf1dc> <color:#b8862e>████</color> | Über Kampagnen hinweg: nicht im Spielstand, mit OneDrive abgeglichen, nicht exportiert |
endlegend
class Task #line:d0021b;line.bold
@enduml
