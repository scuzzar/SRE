' Erzeugt von .claude/skills/domain-model/scripts/views.mjs aus domain-model.puml; nicht von Hand ändern.
@startuml
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
' Entfallender Pfeil: rot gestrichelt, solange die Änderung offen ist
!function $goneArrow($c)
!if $marked($c)
!return "[#d0021b,dashed]"
!endif
!return ""
!endfunction
!pragma layout smetana
title Ausschnitt: Begegnung
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype

' Kampagne und Charaktere
  class Campaign $kampagne
  class Character $charakter

' Charaktererschaffung und Lebenslauf

' Subsektor und Welten
  class Hex $sektor

' Verlauf
  abstract class LogEntry $probe
  class PatronRoll $begegnung {
    dice: number[2]
    dms: number[2]
  }
  class RumorRoll $begegnung {
    dice: number[2]
  }

' Entwürfe: flüchtig, zwischen zwei Eingaben da, nie gespeichert (im Code: model/draft/)
  class Encounter $begegnung {
    at: datetime
    quantityDie: number [0..1]
    $gone("2026-11-12c", "reactionDice: number[2]")
    $new("2026-11-12c", "reactionDice: number[0..2]")
    reactionDm: number [0..1]
    $gone("2026-11-12c", "reaction: number")
    $new("2026-11-12c", "reaction: number [0..1]")
    ended: boolean
    $gone("2026-11-12c", "/reactionText: string")
    $new("2026-11-12c", "/reactionText: string [0..1]")
    $new("2026-11-12c", "tableDice: number[0..2]")
    $new("2026-11-12c", "attackDice: number[0..2]")
    $new("2026-11-12c", "fleeDice: number[0..2]")
    $new("2026-11-12c", "/behavior: Behavior [0..1]")
    rangeDice: number[2]
    bandDie: number [0..1]
    startBand: number
    startClose: boolean
    round: number
    npcMoved: number [0..1]
    npcRuns: number [0..1]
    alarm: number [0..1]
    /surprise: Side [0..1]
    /surprising: Side [0..1]
    /first: Side
  }
  class Distance $begegnung {
    band: number
    close: boolean
    moved: number [0..1]
    runs: number [0..1]
    /range: Range [0..1]
    /escaped: boolean
  }
  class SurpriseRoll <<value>> $begegnung {
    die: number
    dm: number
  }
  enum Side <<value>> $begegnung {
    pcs
    npcs
  }
  class Terrain <<reference>> $begegnung {
    name: string
    dm: number
  }
  class EncounterRange <<reference>> $begegnung {
    roll: number
    range: Range
  }
  class RangeBand <<reference>> $begegnung {
    range: Range
    from: number
    to: number
  }
  class EncounterType <<reference>> $begegnung {
    roll: number
    name: string
    quantity: number
    tl: number
    leader: boolean
    guns: boolean
    armor: boolean
    vehicle: boolean
    military: boolean
  }
  class Patron <<reference>> $begegnung {
    list: number
    roll: number
    name: string
    rumor: boolean
  }
  class AnimalTable $begegnung $newClass("2026-11-12c") {
  }
  class AnimalRow $begegnung $newClass("2026-11-12c") {
    roll: number
    event: boolean
    quantity: number [0..1]
    trait: AnimalTrait [0..1]
    traitSizeDm: number [0..1]
    weight: number [0..1]
    hits: number[0..2]
    armor: ArmorClass [0..1]
    armorDm: number [0..1]
    attack: number [0..1]
    flee: number [0..1]
    speed: number [0..1]
  }
  class AnimalAttack <<value>> $begegnung $newClass("2026-11-12c") {
    dm: number
    damage: number
  }
  enum AnimalTrait <<value>> $begegnung $newClass("2026-11-12c") {
    amphibian
    flyer
    swimmer
    triphibian
  }
  enum Behavior <<value>> $begegnung $newClass("2026-11-12c") {
    attacks
    flees
    nothing
  }
  enum AnimalCategory <<value>> $begegnung $newClass("2026-11-12c") {
    herbivore
    omnivore
    carnivore
    scavenger
  }
  class AnimalTerrain <<reference>> $begegnung $newClass("2026-11-12c") {
    name: string
    equivalent: string
    typeDm: number
    sizeDm: number
    traits: string
  }
  class AnimalType <<reference>> $begegnung $newClass("2026-11-12c") {
    name: string
    category: AnimalCategory
    attack: string
    flee: string
    speed: DiceExpr
    fleesFirst: boolean
  }
  class AnimalTypeRow <<reference>> $begegnung $newClass("2026-11-12c") {
    roll: number
    category: AnimalCategory
    quantity: number [0..1]
  }
  class AnimalTraitRow <<reference>> $begegnung $newClass("2026-11-12c") {
    roll: number
    traits: string
    trait: AnimalTrait [0..1]
    sizeDm: number [0..1]
  }
  class AnimalSizeRow <<reference>> $begegnung $newClass("2026-11-12c") {
    roll: number
    weight: number [0..1]
    hits: DiceExpr[2]
    wounds: string
    weapons: string
    armor: string
  }
  class Rumor <<reference>> $begegnung {
    letter: string
    text: string
    general: boolean
    rolls: number[1..*]
  }

' Referenzdaten
  class Weapon <<reference>> $kampf

' Kampagne

' Charaktererschaffung und Lebenslauf

' Laufbahnen (Referenzdaten)

' Subsektor und Welten

' Charakter

' Waffen (Referenzdaten)

' Verlauf
LogEntry <|-- PatronRoll
PatronRoll "*" --> "1" Patron : of
LogEntry <|-- RumorRoll
RumorRoll "*" --> "1" Rumor : /of

' Probe

' Angriff

' Begegnung
Campaign "1" *-- "*" Encounter : encounters {ordered}
Encounter "*" -$goneArrow("2026-11-12c")-> "1" EncounterType : of
Encounter "*" -$newArrow("2026-11-12c")-> "0..1" EncounterType : of
Encounter "*" -$newArrow("2026-11-12c")-> "0..1" AnimalRow : animal
Hex "1" *-$newArrow("2026-11-12c")- "*" AnimalTable : animals
AnimalTable "*" -$newArrow("2026-11-12c")-> "1" AnimalTerrain : terrain
AnimalTable "1" *-$newArrow("2026-11-12c")- "11" AnimalRow : rows {ordered}
AnimalRow "*" -$newArrow("2026-11-12c")-> "0..1" AnimalType : type
AnimalRow "1" *-$newArrow("2026-11-12c")- "0..2" AnimalAttack : attacks {ordered}
AnimalAttack "*" -$newArrow("2026-11-12c")-> "1" Weapon : with
AnimalRow --> AnimalTrait
Encounter --> Behavior
AnimalType --> AnimalCategory
AnimalTerrain "*" -$newArrow("2026-11-12c")-> "0..1" Terrain : range
AnimalTypeRow "*" -$newArrow("2026-11-12c")-> "1" AnimalType : type
Character "*" -$newArrow("2026-11-12c")-> "0..1" AnimalRow : animal
AnimalSizeRow -[hidden]- AnimalTraitRow
Encounter "*" --> "0..1" Terrain : terrain
Encounter "1" *-- "0..1" SurpriseRoll : pcSurprise
Encounter "1" *-- "0..1" SurpriseRoll : npcSurprise
Encounter --> Side
EncounterRange -[hidden]- Terrain
RangeBand -[hidden]- EncounterRange
Encounter "*" --> "0..1" Hex : in
Encounter "1" *-- "*" Character : npcs {ordered}
Encounter "*" --> "0..1" Character : leader
Encounter "*" --> "*" Character : acted
Encounter "*" --> "0..1" Character : /turn
Encounter "1" *-- "*" Distance : distances
Distance "*" --> "1" Character : of
Encounter "*" --> "*" Character : evading

' Karte


legend right
  |<#e8ecfb> <color:#5b64b8>████</color> | Spielstand, wird gespeichert |
  |<#f4f4f4> <color:#8a8a8a>╌╌╌╌</color> | Flüchtig: zwischen zwei Eingaben da, nie gespeichert |
  |<#e6f4e6> <color:#4f9a4f>████</color> | Referenzdaten: Tabellen, in jeder Kampagne gleich |
  |<#ffffff> <color:#8a8a8a>□□□□</color> | Wert oder Werteliste |
endlegend
class Character #line:d0021b;line.bold
class Encounter #line:d0021b;line.bold
@enduml
