Journey "*" --> "1" Hex : from
Journey "*" --> "1" Hex : to
Journey "1" *-- "0..*" Passenger : passengers
Passenger "*" --> "1" Character : for
Passenger "*" --> "1" Item : passage
Journey "1" *-- "*" LowBerth : berths {ordered}
