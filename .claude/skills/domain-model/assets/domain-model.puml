' Das Domänenmodell von <Projekt>. Es führt: der Code folgt ihm, nie umgekehrt.
' Rendern: bash .claude/skills/domain-model/scripts/render.sh docs/domain-model.puml
@startuml
' Markierung offener Änderungen (siehe Skill domain-model, „Ausschnitte und Markierungen“).
' Ein Kennzeichen wie "2026-11-06" steht an allem, was eine noch nicht freigegebene Änderung
' bringt oder streicht; nach der Freigabe kommen die Kennzeichen wieder heraus. Rot ist also immer,
' was noch nicht freigegeben ist. Ein Änderungsausschnitt setzt $change auf sein Kennzeichen und
' zeigt nur diese Änderung rot; sonst ist alles Offene rot.
!if %not(%variable_exists("$change"))
!$change = "*"
!endif
!function $marked($c)
!return $change == "*" || $change == $c
!endfunction
' Neues oder geändertes Feld
!function $new($c, $t)
!if $marked($c)
!return "<color:#d0021b><b>" + $t + "</b></color>"
!endif
!return $t
!endfunction
' Entfallendes Feld: rot durchgestrichen, solange die Änderung offen ist
!procedure $gone($c, $t)
!if $marked($c)
<color:#d0021b><s>$t</s></color>
!endif
!endprocedure
' Neue Klasse: roter Rahmen
!function $newClass($c)
!if $marked($c)
!return "#line:d0021b;line.bold"
!endif
!return ""
!endfunction
' Neuer Pfeil: rot und dick, z. B. A "1" -$newArrow("2026-11-06")-> "*" B
!function $newArrow($c)
!if $marked($c)
!return "[#d0021b,bold]"
!endif
!return ""
!endfunction
!pragma layout smetana
title <Projekt> – Domänenmodell (Version 1, Entwurf)
hide empty members
hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor #e8ecfb
  BorderColor #5b64b8
  BackgroundColor<<transient>> #f4f4f4
  BorderColor<<transient>> #8a8a8a
  BackgroundColor<<reference>> #e6f4e6
  BorderColor<<reference>> #4f9a4f
  BackgroundColor<<value>> #ffffff
  BorderColor<<value>> #8a8a8a
}
skinparam legendBackgroundColor #ffffff
skinparam legendBorderColor #8a8a8a
<style>
classDiagram {
  class {
    .transient {
      LineStyle 5-3
    }
  }
}
</style>
hide <<transient>> stereotype
hide <<reference>> stereotype
hide <<value>> stereotype

' Gespeicherter Stand (blau)
  class Root {
    name: string
  }
  class Item {
    label: string
    retired: boolean
  }
  abstract class LogEntry {
    at: datetime
  }
  class Result {
    roll: number
    chance: number
    /success: boolean
  }

' Flüchtig (grau): nur wenn ein Ablauf zwischen zwei Eingaben sonst nicht abbildbar ist
  class Draft <<transient>> {
    question: string [0..1]
  }

' Referenzdaten (grün)
  class Kind <<reference>> {
    name: string
  }

' Werte (weiß)
  enum Level <<value>> {
    low
    high
  }

Root "1" *-- "*" Item : items
Root "1" *-- "*" LogEntry : log {ordered}
LogEntry <|-- Result
Result "*" --> "1" Item : for
Item "*" --> "1" Kind : of
Item --> Level
Draft "0..1" --> "1" Root : in
Draft ..> Result : on confirm

legend right
  |<#e8ecfb> <color:#5b64b8>████</color> | Gespeicherter Stand |
  |<#f4f4f4> <color:#8a8a8a>╌╌╌╌</color> | Flüchtig: zwischen zwei Eingaben da, nie gespeichert |
  |<#e6f4e6> <color:#4f9a4f>████</color> | Referenzdaten: feste Tabellen, überall gleich |
  |<#ffffff> <color:#8a8a8a>□□□□</color> | Wert oder Werteliste |
endlegend
@enduml
